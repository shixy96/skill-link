{
  "name": "skilllink",
  "version": "0.1.0",
  "description": "Skill management tool with GitHub CLI integration and symlink support",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "skilllink": "./dist/cli.js"
  },
  "main": "./dist-electron/main.js",
  "files": [
    "dist/",
    "dist-electron/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "ci": "npm run typecheck && npm test -- --run && npm run electron:pack",
    "dev": "tsx watch src/cli.ts",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "release:check": "node scripts/validate-release.mjs && npm run ci",
    "release:build": "npm run release:check && npm run electron:build",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:pack": "npm run build && npm run build:renderer && npm run build:electron",
    "electron:build": "npm run electron:pack && electron-builder",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "keywords": [
    "skill",
    "github",
    "symlink",
    "claude",
    "electron",
    "agent-skills"
  ],
  "author": "SkillLink contributors",
  "license": "MIT",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.8",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.skilllink.app",
    "productName": "SkillLink",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "zip"
    }
  }
}
